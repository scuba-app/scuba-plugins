{
  "name": "scuba",
  "version": "0.1.3",
  "description": "Search your saved Captures and Collections, then save useful findings to Scuba.",
  "author": {
    "name": "Scuba",
    "email": "support@scuba.app",
    "url": "https://scuba.app"
  },
  "homepage": "https://github.com/scuba-app/scuba-plugins",
  "keywords": [
    "scuba",
    "search",
    "research",
    "captures",
    "collections"
  ],
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Scuba",
        "shortDescription": "Find and save useful context",
        "longDescription": "Bring your saved context into your conversation. Search and read Captures and Collections, save notes and links, and organize useful findings in Scuba.",
        "developerName": "Scuba",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://scuba.app",
        "privacyPolicyURL": "https://scuba.app/privacy",
        "termsOfServiceURL": "https://scuba.app/terms",
        "defaultPrompt": [
          "Find the Capture about our onboarding decisions.",
          "Save this summary to Scuba as a text Capture."
        ],
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png",
        "supportURL": "https://scuba.app/support"
      }
    }
  },
  "repository": "https://github.com/scuba-app/scuba-plugins",
  "license": "MIT"
}
